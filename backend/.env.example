# ============================================================================
# Email Configuration
# ============================================================================

# Mode: online | offline
MAIL_MODE=online

# SMTP Server Details
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@ics-system.local
MAIL_FROM_NAME=ICS System

# Security
MAIL_ENCRYPTION=tls
MAIL_VERIFY_SSL=false

# ============================================================================
# Alternative: Office 365 Configuration (uncomment to use)
# ============================================================================
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@company.com
# MAIL_PASSWORD=your-password
# MAIL_ENCRYPTION=tls
# MAIL_VERIFY_SSL=false

# ============================================================================
# Alternative: Custom SMTP Configuration (uncomment to use)
# ============================================================================
# MAIL_HOST=mail.yourdomain.com
# MAIL_PORT=587
# MAIL_USERNAME=no-reply@yourdomain.com
# MAIL_PASSWORD=your-password
# MAIL_ENCRYPTION=tls
# MAIL_VERIFY_SSL=false

# ============================================================================
# Database Configuration (usually handled by Docker)
# ============================================================================
MYSQL_HOST=db
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=my_app_db

# ============================================================================
# Application Configuration
# ============================================================================
APP_ENV=production
APP_DEBUG=false
